{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Export Manifest",
  "description": "L5 Export Layer 唯一出口协议。前置条件 = Export Gate：L3 QA 全绿 + L4 Critic average>=8 + Freeze protocol passed + Build IDs 完整。所有路径字段一律为仓库相对路径以便追溯；所有 token 映射必须能沿 dsToken 点路径回溯到 DS Spec 原文。",
  "type": "object",
  "required": ["project", "version", "source", "exports", "mapping", "tokens", "audit"],
  "allOf": [
    {
      "if": { "properties": { "_meta": { "type": "object", "properties": { "status": { "const": "design-phase" } }, "required": ["status"] } } },
      "then": { "properties": { "exports": { "properties": { "png": { "minItems": 0 } } } },
                "description": "design-phase（未过 Export Gate 的规划态）允许 exports.png 为空；live-build 必须 ≥1" }
    }
  ],
  "properties": {
    "project":   { "type": "string", "description": "产品名，与 Brief.product.name / brand.name 一致" },
    "version":   { "type": "string", "description": "清单版本（如 1.0.0 或 stage 标签）；导出物变更必须递增" },

    "source": {
      "type": "object",
      "required": ["brief", "dsSpec", "figmaFileKey", "rootNodeIds"],
      "properties": {
        "brief":       { "type": "string", "description": "L1 Brief JSON 的仓库相对路径（追溯链起点）" },
        "dsSpec":      { "type": "string", "description": "L2 DS Spec JSON 的仓库相对路径" },
        "figmaFileKey":{ "type": ["string", "null"], "description": "Figma 文件 key；design-phase（未建画布）时为 null 并在 _meta.note 说明" },
        "rootNodeIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\d+:\\d+$" },
          "description": "导出根节点 id（页框/画板），QA 用该清单做 id 格式与数量校验"
        }
      }
    },

    "exports": {
      "type": "object",
      "required": ["png", "svg", "figmaJson", "designSpec"],
      "properties": {
        "png": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nodeId", "name", "scale", "path"],
            "properties": {
              "nodeId": { "type": "string", "pattern": "^\\d+:\\d+$" },
              "name":   { "type": "string" },
              "scale":  { "type": "integer", "enum": [1, 2] },
              "path":   { "type": "string", "description": "仓库相对路径" },
              "bytes":  { "type": "integer" },
              "existsCheck": { "type": "boolean", "default": true, "description": "false = design-phase 规划路径，QA 跳过磁盘检查" }
            }
          }
        },
        "svg": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeId", "name", "path"],
            "properties": {
              "nodeId": { "type": "string", "pattern": "^\\d+:\\d+$" },
              "name":   { "type": "string" },
              "path":   { "type": "string" },
              "bytes":  { "type": "integer" },
              "scope":  { "type": "string", "enum": ["page", "icon", "vector"], "description": "页面级矢量 / 图标 / 单个 Vector" },
              "existsCheck": { "type": "boolean", "default": true }
            }
          }
        },
        "figmaJson": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path":      { "type": ["string", "null"], "description": "Node Tree/Geometry/AutoLayout/Instance/TokenReference 的 JSON 快照路径；design-phase 为 null" },
            "nodeCount": { "type": "integer", "minimum": 0 },
            "contents":  { "type": "array", "items": { "type": "string" }, "description": "包含的切片：node-tree/geometry/auto-layout/component-instance/token-reference" }
          }
        },
        "designSpec": {
          "type": "object",
          "required": ["brief", "dsSpec"],
          "properties": {
            "brief":       { "type": "string", "description": "随包分发的 Brief JSON 副本路径" },
            "dsSpec":      { "type": "string", "description": "随包分发的 DS Spec JSON 副本路径" },
            "buildPlan":   { "type": ["string", "null"], "description": "L2 buildPlan 或 L3 build-log 快照路径" },
            "criticReport":{ "type": ["string", "null"], "description": "L4 Critic Report 路径（必须为 PASS 轮次）" }
          }
        }
      }
    },

    "mapping": {
      "type": "object",
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["figmaComponent", "dsName", "class"],
            "allOf": [
              {
                "if": { "properties": { "class": { "const": "C-manual" } } },
                "then": { "properties": { "frontendComponent": { "type": ["string", "null"] } },
                          "description": "C 类允许 frontendComponent=null（复杂插画/自由布局），必须给 manualNote" },
                "else": { "required": ["frontendComponent"],
                          "properties": { "frontendComponent": { "type": "string", "minLength": 1 } } }
              }
            ],
            "properties": {
              "figmaComponent":    { "type": "string", "description": "Figma 侧组件名/命名（DS/Form/Button 或 Local/<Page>/<Name>）" },
              "dsName":            { "type": "string", "description": "DS Spec components[].name，必须能在对应 dsspec 中找到（decision != reject）" },
              "class":             { "type": "string", "enum": ["A-direct", "B-composite", "C-manual"], "description": "A=直接映射 / B=组合映射 / C=不可自动映射（见 references/export-mapping.md）" },
              "frontendComponent": { "type": ["string", "null"], "description": "Vue/React 组件名，如 DsButton / DsButton(React)" },
              "props":             { "type": "array", "items": { "type": "string" }, "description": "属性映射，如 'variant: primary|secondary|disabled|loading <- DS/Form/Button 四态组件'" },
              "variants":          { "type": "array", "items": { "type": "string" }, "description": "Figma variant/state 清单" },
              "manualNote":        { "type": "string", "description": "C 类必填：为何不可自动映射 + 人工实现入口" }
            }
          }
        },
        "layoutRules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Layout -> Implementation Rules：auto-layout → flex/grid 的转换约定"
        }
      }
    },

    "tokens": {
      "type": "object",
      "required": ["color", "typography", "spacing", "radius", "shadow"],
      "properties": {
        "color":      { "$ref": "#/definitions/tokenMappingList", "minItems": 8 },
        "typography": { "$ref": "#/definitions/tokenMappingList", "minItems": 5 },
        "spacing":    { "$ref": "#/definitions/tokenMappingList" },
        "radius":     { "$ref": "#/definitions/tokenMappingList" },
        "shadow":     { "$ref": "#/definitions/tokenMappingList" }
      }
    },

    "audit": {
      "type": "object",
      "required": ["qaPassed", "criticScore", "freezeStatus"],
      "properties": {
        "qaPassed":    { "type": ["boolean", "string"], "description": "L3 QA 结果（如 true 或 'QA1-QA5 37 PASS / 0 FAIL'）" },
        "criticScore": { "type": "number", "minimum": 0, "maximum": 10, "description": "L4 Critic 最终 average，必须 >=8（Export Gate）" },
        "freezeStatus":{ "type": "string", "enum": ["passed", "failed", "pending"], "description": "冻结协议结论（QA5/冻结文件零命令）" }
      }
    },

    "_meta": {
      "type": "object",
      "properties": {
        "generatedAt": { "type": "string" },
        "status":      { "type": "string", "enum": ["live-build", "design-phase"], "description": "live-build=真实构建产物（QA3 做强校验）；design-phase=示例/规划（QA3 弱校验）" },
        "note":        { "type": "string" }
      }
    }
  },

  "definitions": {
    "tokenMappingList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dsToken", "cssVariable", "source"],
        "properties": {
          "dsToken":     { "type": "string", "pattern": "^tokens\\.[a-zA-Z0-9.]+$", "description": "DS Spec 内的点路径，QA 沿路径回溯验证存在" },
          "value":       { "type": ["string", "number"], "description": "导出时刻的 token 值快照" },
          "cssVariable": { "type": "string", "pattern": "^--ds-[a-z0-9-]+$", "description": "CSS Variable 命名规则：--ds- + tokens. 后路径转 kebab（'.'→'-'，camelCase 边界→'-'，如 cardPadding→card-padding）" },
          "source":      { "type": "string", "description": "继承 DS Spec 的 source（preset:/brief:/rule:/derived:/existing-ds: 前缀），保证可追溯" }
        }
      }
    }
  }
}
