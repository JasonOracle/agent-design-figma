  "buildPlan": {
    "strategy": "ds-first：先 READ 校验 11 个既有 DS 组件存在性（禁止盲目 create-component），再按页分区构建；每批 ≤30 ops，WRITE→READBACK，as: 映射逐批落盘 build-ids",
    "batches": [
      { "seq": 1, "target": "DS 存在性校验 + 分区坐标规划（只读）", "estOps": 12 },
      { "seq": 2, "target": "Dashboard：Sidebar+TopBar+KpiGrid", "estOps": 28 },
      { "seq": 3, "target": "Dashboard：ChartArea+TodoTable", "estOps": 24 },
      { "seq": 4, "target": "用户管理：FilterRow+TableArea+Pagination", "estOps": 26 },
      { "seq": 5, "target": "考试管理：8 列表格区", "estOps": 30 },
      { "seq": 6, "target": "考试详情：ExamCard+双 Tab", "estOps": 22 },
      { "seq": 7, "target": "系统设置：三组表单卡", "estOps": 25 },
      { "seq": 8, "target": "登录页 + 五级 QA 审计", "estOps": 18 }
    ]
