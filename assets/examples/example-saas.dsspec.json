      { "name": "wide",    "width": 1920 }
    ],
    "rules": [
      "web-admin 不做移动断点；内容区 FILL 自适应三档宽度",
      "1280 档：Sidebar 收窄为图标模式（64px），KPI 网格降为 2 列",
      "1920 档：内容区最大宽度 1680 居中，避免表格无限拉伸"
    ]
